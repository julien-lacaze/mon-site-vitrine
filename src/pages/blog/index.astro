---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoryColor } from '../../config/categoryColors.js';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

function readingTime(body: string): number {
  const words = body.split(/\s+/).filter(w => w.length > 0).length;
  return Math.max(1, Math.ceil(words / 200));
}

const categories = ['Marketing', 'IA', 'No-code', 'Productivité', 'Entrepreneuriat'] as const;
---

<Layout
  title="Blog"
  description="Articles sur le marketing B2B, l'IA, le no-code et la productivité, par Julien Lacaze, CMO freelance"
>

  <!-- En-tête (fond cacao) -->
  <section class="head">
    <div class="wrap head-inner">
      <h1 class="head-title fade-up fade-up-delay-1">Carnet de marketeur. <span class="caramel">Vu du terrain.</span></h1>
      <p class="head-sub fade-up fade-up-delay-2">
        Marketing BtoB, IA, No-code, productivité et entrepreneuriat. Des articles pratiques
        autant pour les entrepreneurs qui se lancent que pour les équipes marketing
        qui souhaitent accélérer.
      </p>
    </div>
  </section>

  <!-- Filtres + grille -->
  <section class="wrap articles">

    <div class="filters" role="group" aria-label="Filtrer par catégorie">
      <button type="button" class="filter-btn active" data-filter="tous" aria-pressed="true">Tous</button>
      {categories.map(cat => (
        <button type="button" class="filter-btn" data-filter={cat} aria-pressed="false" style={`--filter-accent: ${categoryColor(cat)};`}>{cat}</button>
      ))}
    </div>

    <div id="articles-grid" class="grid">
      {posts.map((post, i) => {
        const rt = readingTime((post.body as string | undefined) ?? '');
        const date = new Date(post.data.date).toLocaleDateString('fr-FR', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        return (
          <a
            href={`/blog/${post.id}/`}
            class={`post reveal${i < 3 ? ` reveal-delay-${i + 1}` : ''}`}
            data-category={post.data.category}
          >
            <div class="post-top">
              <span class="post-cat" style={`background: ${categoryColor(post.data.category)};`}>{post.data.category}</span>
              <span class="post-date">{date}</span>
            </div>
            <h2 class="post-title">{post.data.title}</h2>
            <p class="post-desc">{post.data.description}</p>
            <div class="post-foot">
              <span>{rt} min de lecture</span>
              <span class="post-link">Lire l'article</span>
            </div>
          </a>
        );
      })}
    </div>

    <p id="empty-state" class="empty">Aucun article dans cette catégorie pour l'instant.</p>
  </section>

  <style>
    .wrap { max-width: 1240px; margin: 0 auto; padding-left: 1.75rem; padding-right: 1.75rem; }
    .caramel { color: var(--color-caramel); }

    .head { background: var(--color-dark); color: var(--color-on-dark); padding: 8rem 0 4rem; }
    .head-inner { display: flex; flex-direction: column; gap: 1.2rem; }
    .head-title { font-size: clamp(2.4rem, 7vw, 5.4rem); max-width: 12em; }
    .head-sub { font-size: 1.1rem; color: var(--color-muted-on-dark); max-width: 36em; }

    .articles { padding-top: 3.5rem; padding-bottom: 5rem; }
    .filters { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2.5rem; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }
    .post { background: var(--color-surface); border-radius: 6px; padding: 1.6rem; display: flex; flex-direction: column; gap: 0.8rem; transition: transform 0.25s ease, box-shadow 0.25s ease; }
    .post:hover { transform: translateY(-3px); box-shadow: 0 12px 30px -18px rgba(43, 31, 25, 0.45); }
    .post-top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .post-cat { color: #FFFFFF; font-size: 0.8rem; font-weight: 700; padding: 0.2rem 0.7rem; border-radius: 999px; }
    .post-date { font-size: 0.85rem; color: var(--color-muted); }
    .post-title { font-size: 1.45rem; line-height: 1.15; }
    .post-desc { color: var(--color-muted); font-size: 0.95rem; flex: 1; }
    .post-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid var(--color-border); font-size: 0.85rem; color: var(--color-muted); }
    .post-link { font-weight: 700; color: var(--color-accent); }
    .post-link::after { content: ' →'; }

    .empty { display: none; color: var(--color-muted); padding: 3rem 0; }

    @media (max-width: 700px) {
      .wrap { padding-left: 1.25rem !important; padding-right: 1.25rem !important; }
      .head { padding: 7rem 0 3rem !important; }
      .grid { grid-template-columns: minmax(0, 1fr); }
    }
  </style>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const articles = document.querySelectorAll<HTMLElement>('#articles-grid a');
    const emptyState = document.getElementById('empty-state');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'tous';

        buttons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        let visible = 0;
        articles.forEach(article => {
          const cat = article.dataset.category ?? '';
          const show = filter === 'tous' || cat === filter;
          article.style.display = show ? 'flex' : 'none';
          if (show) visible++;
        });

        if (emptyState) {
          emptyState.style.display = visible === 0 ? 'block' : 'none';
        }
      });
    });
  </script>

</Layout>
