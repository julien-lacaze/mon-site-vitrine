---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const rawBody = (post.body as string | undefined) ?? '';
const wordCount = rawBody.split(/\s+/).filter(w => w.length > 0).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedDate = new Date(post.data.date).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={post.data.title}
  description={post.data.description}
>

  <!-- Header article -->
  <section style="
    padding: 10rem 3rem 4rem;
    max-width: 780px;
    margin: 0 auto;
  ">

    <!-- Fil d'Ariane -->
    <a href="/blog" class="fade-up fade-up-delay-1" style="
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      color: var(--color-muted);
      letter-spacing: 0.05em;
      margin-bottom: 3rem;
      transition: color 0.2s ease;
    " onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='var(--color-muted)'">
      ← Blog
    </a>

    <!-- Catégorie -->
    <div class="fade-up fade-up-delay-1" style="margin-bottom: 1.5rem;">
      <span class="tag">{post.data.category}</span>
    </div>

    <!-- Titre -->
    <h1 class="fade-up fade-up-delay-2" style="
      font-size: clamp(2rem, 5vw, 3.5rem);
      line-height: 1.1;
      margin-bottom: 1.5rem;
      max-width: 680px;
    ">{post.data.title}</h1>

    <!-- Meta -->
    <div class="fade-up fade-up-delay-3" style="
      display: flex;
      align-items: center;
      gap: 1.5rem;
      font-size: 0.8rem;
      color: var(--color-muted);
      margin-bottom: 3rem;
      padding-bottom: 3rem;
      border-bottom: 1px solid var(--color-border);
    ">
      <span>{formattedDate}</span>
      <span style="opacity: 0.4;">·</span>
      <span>{readingTime} min de lecture</span>
    </div>

  </section>

  <!-- Corps de l'article -->
  <article style="
    max-width: 780px;
    margin: 0 auto;
    padding: 0 3rem 8rem;
  ">

    <!-- TL;DR -->
    {post.data.tldr && post.data.tldr.length > 0 && (
      <div style="
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-accent);
        border-radius: 2px;
        padding: 1.75rem 2rem;
        margin-bottom: 3rem;
      ">
        <p style="
          font-size: 0.7rem;
          font-weight: 500;
          letter-spacing: 0.12em;
          text-transform: uppercase;
          color: var(--color-accent);
          margin-bottom: 1rem;
          text-align: left;
        ">TL;DR</p>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem;">
          {post.data.tldr.map(point => (
            <li style="
              display: flex;
              gap: 0.75rem;
              font-size: 0.9rem;
              color: var(--color-text);
              line-height: 1.6;
              text-align: left;
            ">
              <span style="color: var(--color-accent); flex-shrink: 0; margin-top: 0.1rem;">—</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <!-- CTA bas de page -->
    <div style="
      margin-top: 5rem;
      padding: 2.5rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 2px;
    ">
      <p style="
        font-family: var(--font-display);
        font-size: 1.3rem;
        margin-bottom: 0.75rem;
        line-height: 1.3;
      ">Envie d'en discuter ?</p>
      <p style="color: var(--color-muted); font-size: 0.9rem; margin-bottom: 1.5rem; text-align: left;">
        Si cet article a résonné avec votre situation, je serai ravi d'échanger sur votre contexte spécifique.
      </p>
      <a href="/#contact" style="
        display: inline-block;
        background: var(--color-accent);
        color: var(--color-bg);
        padding: 0.75rem 1.75rem;
        font-size: 0.82rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-radius: 8px;
        transition: opacity 0.2s ease;
      " onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
        Travaillons ensemble
      </a>
    </div>

    <!-- Retour blog -->
    <div style="margin-top: 3rem; text-align: center;">
      <a href="/blog" style="
        font-size: 0.8rem;
        color: var(--color-muted);
        letter-spacing: 0.05em;
        transition: color 0.2s ease;
      " onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='var(--color-muted)'">
        ← Tous les articles
      </a>
    </div>

  </article>

</Layout>
