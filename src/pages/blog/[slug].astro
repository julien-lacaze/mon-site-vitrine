---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { categoryColor } from '../../config/categoryColors.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => !post.data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const rawBody = (post.body as string | undefined) ?? '';
const wordCount = rawBody.split(/\s+/).filter(w => w.length > 0).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formattedDate = new Date(post.data.date).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const accentColor = categoryColor(post.data.category);
---

<Layout
  title={post.data.title}
  metaTitle={post.data.metaTitle}
  description={post.data.description}
>

  <!-- En-tête de l'article (fond cacao) -->
  <section class="head">
    <div class="narrow head-inner">
      <a href="/blog" class="back fade-up fade-up-delay-1">← Blog</a>
      <span class="cat fade-up fade-up-delay-1" style={`background: ${accentColor};`}>{post.data.category}</span>
      <h1 class="title fade-up fade-up-delay-2">{post.data.title}</h1>
      <p class="meta fade-up fade-up-delay-3">{formattedDate} · {readingTime} min de lecture</p>
    </div>
  </section>

  <!-- Corps de l'article -->
  <article class="narrow body">

    {post.data.tldr && post.data.tldr.length > 0 && (
      <div class="tldr">
        <p class="tldr-title">L'essentiel</p>
        <ul class="tldr-list">
          {post.data.tldr.map(point => <li>{point}</li>)}
        </ul>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <!-- Appel à l'action -->
    <div class="cta">
      <p class="cta-title">Envie d'en discuter ?</p>
      <p class="cta-text">
        Si cet article a résonné avec votre situation, je serai ravi d'échanger sur votre contexte spécifique.
      </p>
      <a href="https://calendly.com/julien-lacaze-pro/cafe-virtuel" target="_blank" rel="noopener noreferrer" class="cta-btn">
        Prendre un rendez-vous
      </a>
    </div>

    <div class="back-bottom">
      <a href="/blog">← Tous les articles</a>
    </div>

  </article>

  <style>
    .narrow { max-width: 760px; margin: 0 auto; padding-left: 1.75rem; padding-right: 1.75rem; }

    .head { background: var(--color-dark); color: var(--color-on-dark); padding: 8rem 0 3.5rem; }
    .head-inner { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; }
    .back { font-size: 0.9rem; font-weight: 600; color: var(--color-muted-on-dark); margin-bottom: 1rem; }
    .back:hover { color: var(--color-caramel); }
    .cat { color: #FFFFFF; font-size: 0.85rem; font-weight: 700; padding: 0.25rem 0.8rem; border-radius: 999px; }
    .title { font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.02; color: var(--color-on-dark); }
    .meta { font-size: 0.95rem; color: var(--color-muted-on-dark); }

    .body { padding-top: 3rem; padding-bottom: 5rem; }

    .tldr { background: var(--color-surface); border-radius: 6px; padding: 1.5rem 1.75rem; margin-bottom: 2.5rem; border-top: 4px solid var(--color-caramel); }
    .tldr-title { font-family: var(--font-display); font-weight: 800; font-stretch: 108%; font-size: 1.15rem; margin-bottom: 0.8rem; }
    .tldr-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; }
    .tldr-list li { position: relative; padding-left: 1.2rem; font-size: 0.98rem; }
    .tldr-list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 8px; height: 8px; border-radius: 2px; background: var(--color-caramel); }

    .cta { margin-top: 4rem; padding: 2.2rem; background: var(--color-dark); color: var(--color-on-dark); border-radius: 6px; }
    .cta-title { font-family: var(--font-display); font-weight: 800; font-stretch: 112%; font-size: 1.7rem; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 0.7rem; }
    .cta-text { color: var(--color-muted-on-dark); margin-bottom: 1.5rem; }
    .cta-btn { display: inline-block; background: var(--color-caramel); color: var(--color-dark); padding: 0.9rem 1.5rem; font-weight: 700; border-radius: 6px; transition: opacity 0.2s ease; }
    .cta-btn:hover { opacity: 0.88; }

    .back-bottom { margin-top: 2.5rem; text-align: center; }
    .back-bottom a { font-weight: 600; color: var(--color-muted); }
    .back-bottom a:hover { color: var(--color-accent); }

    @media (max-width: 700px) {
      .narrow { padding-left: 1.25rem !important; padding-right: 1.25rem !important; }
      .head { padding: 7rem 0 2.5rem !important; }
      .cta { padding: 1.6rem; }
    }
  </style>

</Layout>
