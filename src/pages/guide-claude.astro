---
import Layout from '../layouts/Layout.astro';

// Lien du formulaire Tally qui collecte les emails (formulaire publié sur Tally).
// La page de remerciement du formulaire renvoie vers le guide complet.
const TALLY_URL = 'https://tally.so/r/pb8aO8';

// Le guide express reste en accès libre, sans email : c'est l'avant-goût du guide complet.
const EXPRESS_PDF = '/guides/guide-claude-les-bases-express.pdf';

const programme = [
  { num: '01', title: "Faut-il utiliser l'IA ?", text: 'Un arbre de décision en 5 questions, et 5 cas limites commentés.' },
  { num: '02', title: 'Les trois portes', text: 'Claude, Cowork, Claude Code : lequel pour quel besoin.', exclusif: true },
  { num: '03', title: 'Les modèles', text: 'Haiku, Sonnet, Opus : quel modèle pour quelle tâche.', exclusif: true },
  { num: '04', title: 'Les tarifs', text: 'Quel plan pour quel profil, et quand ne pas payer plus.', exclusif: true },
  { num: '05', title: 'Le setup', text: 'Les 9 réglages qui changent tout, avec des modèles à copier.' },
  { num: '06', title: 'Bien demander', text: 'Les 4 réflexes pour obtenir de bonnes réponses.' },
  { num: '07', title: 'Limites et vigilance', text: 'Hallucinations, injections de prompt, données personnelles, biais. Et une checklist RGPD en 7 points.' },
  { num: '08', title: 'Sobriété', text: 'Des ordres de grandeur sourcés et 9 gestes concrets.' },
  { num: '09', title: 'Garder la main', text: "Dépendance cognitive, flatterie de l'IA, la règle des 3 temps." },
  { num: '10', title: 'Trois exercices', text: 'Setup, avant/après, tri et vérification. Avec votre vrai compte.', exclusif: true },
  { num: '11', title: 'Aller plus loin', text: 'Glossaire, sources et ressources.', exclusif: true },
];

// Comparatif express / complet. Une cellule est soit un texte, soit une jauge [fait, total], soit absente (null).
type Cell = string | [number, number] | null;
const comparatif: { label: string; express: Cell; complet: Cell }[] = [
  { label: 'Arbre de décision en 5 questions', express: 'Oui', complet: 'Oui, + 5 cas limites commentés' },
  { label: 'Les trois portes : Claude, Cowork, Claude Code', express: null, complet: 'Oui' },
  { label: 'Modèles et tarifs : quoi choisir', express: null, complet: 'Oui' },
  { label: 'Réglages prêts à copier', express: [2, 9], complet: [9, 9] },
  { label: 'Réflexes pour bien demander', express: [1, 4], complet: [4, 4] },
  { label: 'Limites et vigilance', express: '3 choses à ne pas coller', complet: '4 risques + checklist RGPD' },
  { label: 'Sobriété', express: '5 gestes', complet: '9 gestes + chiffres sourcés' },
  { label: 'Exercices pratiques', express: [1, 3], complet: [3, 3] },
  { label: 'Glossaire et sources', express: null, complet: 'Oui' },
];

const faq = [
  {
    q: "Je n'y connais rien en IA. Ce guide est-il pour moi ?",
    a: "Oui, c'est précisément pour vous. Il s'adresse aux indépendants, entrepreneurs et membres d'une équipe qui démarrent avec Claude. Pas besoin de savoir coder, ni de connaître l'IA.",
  },
  {
    q: 'Le guide est-il vraiment gratuit ?',
    a: "Oui, les deux versions. Pour le guide complet, vous laissez votre email et vous le téléchargez tout de suite. La version express est en accès libre, sans email. Rien à payer, aucune carte bancaire demandée.",
  },
  {
    q: 'Quelle différence entre la version express et le guide complet ?',
    a: "La version express (9 pages) donne les premiers réflexes : quand utiliser l'IA, 2 réglages, le réflexe n°1 pour bien demander. Le guide complet (23 pages) couvre tout : les outils, les modèles, les tarifs, les 9 réglages, les 4 réflexes, les limites, les chiffres de sobriété sourcés, 3 exercices, un glossaire et les sources.",
  },
  {
    q: 'Que faites-vous de mon email ?',
    a: "Il me permet de savoir qui lit le guide et, si vous l'acceptez, de vous recontacter avec des ressources sur l'IA utilisée avec méthode et sobriété. Il n'est ni vendu ni partagé. Un simple message suffit pour le faire supprimer.",
  },
  {
    q: 'Et si je veux aller plus loin ?',
    a: "Je propose des formations d'une demi-journée ou d'une journée, l'accompagnement de votre équipe, et un audit de sobriété de vos usages de l'IA. Le plus simple : prenons un café virtuel.",
  },
];
---

<Layout
  title="Guide Claude"
  metaTitle="Guide gratuit : Claude, les bases pour tout comprendre | Julien Lacaze"
  description="Guide complet gratuit pour démarrer avec Claude avec méthode, esprit critique et sobriété. 23 pages, 11 sections, 9 réglages prêts à copier, 3 exercices. Sans jargon."
>

  <!-- Hero -->
  <section id="guide-hero" style="
    padding: 10rem 3rem 6rem;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 5rem;
    align-items: center;
  ">
    <div>
      <span class="tag fade-up">Guide complet gratuit · PDF</span>
      <h1 class="fade-up fade-up-delay-1" style="
        font-size: clamp(2.8rem, 5.5vw, 5rem);
        margin-top: 1.5rem;
        line-height: 1.05;
      ">
        Claude : les bases pour
        <em style="color: var(--color-accent); font-style: italic;">tout</em> comprendre.
      </h1>
      <p class="fade-up fade-up-delay-2" style="
        color: var(--color-muted);
        max-width: 540px;
        margin-top: 1.75rem;
        font-size: 1.1rem;
        line-height: 1.8;
        text-align: left;
      ">
        Le guide pour démarrer avec l'IA avec méthode, esprit critique et sobriété.
        Quel outil choisir, comment le régler, comment bien demander, et ce qu'il ne faut jamais lui confier.
      </p>

      <div class="fade-up fade-up-delay-3" style="margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem;">
        <a href={TALLY_URL} class="guide-cta">Recevoir le guide complet</a>
        <span style="font-size: 0.85rem; color: var(--color-muted);">Téléchargement immédiat après inscription</span>
      </div>

      <ul class="fade-up fade-up-delay-4" style="
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2rem;
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.85rem;
        color: var(--color-muted);
      ">
        <li><strong style="font-weight: 500; color: var(--color-text);">23 pages</strong>, 11 sections</li>
        <li><strong style="font-weight: 500; color: var(--color-text);">9 réglages</strong> prêts à copier</li>
        <li><strong style="font-weight: 500; color: var(--color-text);">3 exercices</strong> pratiques</li>
        <li><strong style="font-weight: 500; color: var(--color-text);">0 jargon</strong></li>
      </ul>
      <a href="#express-ou-complet" class="fade-up fade-up-delay-4 hover-accent" style="display: inline-block; margin-top: 1.5rem; font-size: 0.85rem; color: var(--color-accent);">
        Pas encore prêt ? Découvrez d'abord la version express, sans email
      </a>
    </div>

    <div id="guide-cover" class="fade-up fade-up-delay-2">
      <img
        src="/guides/couverture-guide-claude.jpg"
        alt=""
        width="900"
        height="1272"
        class="cover-back"
      />
      <img
        src="/guides/couverture-guide-claude-complet.jpg"
        alt="Couverture du guide complet « Claude : les bases pour tout comprendre » par Julien Lacaze"
        width="900"
        height="1272"
        class="cover-front"
      />
    </div>
  </section>

  <!-- Pour qui -->
  <section style="
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  ">
    <div style="max-width: 900px; margin: 0 auto; padding: 6rem 3rem; text-align: center;" class="reveal">
      <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.5rem; text-align: center;">Pour qui ?</p>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 1.2;">
        Vous avez ouvert Claude, posé deux questions,
        et vous vous demandez si vous l'utilisez <em style="color: var(--color-accent);">vraiment</em> bien ?
      </h2>
      <p style="color: var(--color-muted); margin-top: 2rem; font-size: 1.05rem; line-height: 1.8; text-align: center;">
        Ce guide s'adresse aux indépendants, entrepreneurs et membres d'une équipe qui démarrent avec l'IA.
        Pas besoin de savoir coder. L'objectif : que Claude travaille vraiment pour vous, sans que vous perdiez la main.
      </p>
    </div>
  </section>

  <!-- Programme -->
  <section style="max-width: 1400px; margin: 0 auto; padding: 8rem 3rem 4rem;">
    <div class="reveal" style="max-width: 700px; margin-bottom: 4rem;">
      <div class="sep"></div>
      <h2 style="font-size: clamp(2rem, 4vw, 3.2rem);">Au programme : 11 sections</h2>
      <p style="color: var(--color-muted); margin-top: 1.25rem; font-size: 1rem; line-height: 1.8; text-align: left;">
        Chaque section se termine par un « réflexe responsable » : le bon geste éthique ou écologique à retenir.
        Celles marquées <span class="badge-exclusif">Complet</span> ne figurent pas du tout dans la version express.
      </p>
    </div>

    <ol id="guide-programme" style="list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 4rem;">
      {programme.map((s) => (
        <li class="programme-item reveal">
          <span class="programme-num">{s.num}</span>
          <div>
            <h3 style="font-size: 1.25rem; line-height: 1.3; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem;">
              {s.title}
              {s.exclusif && <span class="badge-exclusif">Complet</span>}
            </h3>
            <p style="font-size: 0.92rem; color: var(--color-muted); line-height: 1.6; margin-top: 0.35rem; text-align: left;">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Extrait -->
  <section style="max-width: 1100px; margin: 0 auto; padding: 4rem 3rem 6rem;">
    <div class="reveal">
      <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Un avant-goût</p>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin-bottom: 2.5rem;">Le réflexe n°1, en action</h2>
    </div>
    <div id="guide-extrait" style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
      <div class="reveal-left" style="border: 1px solid var(--color-border); padding: 2rem; border-radius: 2px;">
        <p style="font-size: 0.72rem; color: var(--color-muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Avant</p>
        <p style="font-family: var(--font-display); font-size: 1.3rem; line-height: 1.4; text-align: left;">« Fais-moi un post LinkedIn. »</p>
      </div>
      <div class="reveal-right" style="background: var(--color-text); color: var(--color-bg); padding: 2rem; border-radius: 2px;">
        <p style="font-size: 0.72rem; color: var(--color-border); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Après</p>
        <p style="font-family: var(--font-display); font-size: 1.15rem; line-height: 1.6; text-align: left;">
          « Je suis [métier]. Écris un post LinkedIn de 120 mots pour des dirigeants de PME, sur [sujet].
          Ton direct et chaleureux, pas de jargon. Termine par une question.
          Si tu as besoin d'informations, pose-moi 3 questions avant. »
        </p>
      </div>
    </div>
    <p class="reveal" style="color: var(--color-muted); margin-top: 1.5rem; font-size: 0.95rem; text-align: left;">
      Même outil, même minute passée. Le guide complet détaille les 4 réflexes (contexte, format, questions, critique) et un exercice pour les tester sur une vraie demande de votre semaine.
    </p>
  </section>

  <!-- Chiffres de sobriété -->
  <section style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto; padding: 6rem 3rem;">
      <div class="reveal" style="max-width: 700px; margin-bottom: 3rem;">
        <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Sobriété</p>
        <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.6rem);">Des ordres de grandeur sourcés, pas des impressions</h2>
      </div>
      <div id="guide-chiffres" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
        <div class="chiffre reveal-pop reveal-delay-1">
          <p class="chiffre-valeur">4,4 %</p>
          <p class="chiffre-label">de l'empreinte carbone de la France vient du numérique</p>
          <p class="chiffre-source">ADEME et Arcep, 2022</p>
        </div>
        <div class="chiffre reveal-pop reveal-delay-2">
          <p class="chiffre-valeur">0,03 à 1,14 g</p>
          <p class="chiffre-label">de CO2e par requête texte, selon la méthode de mesure</p>
          <p class="chiffre-source">Google et Mistral AI, 2025</p>
        </div>
        <div class="chiffre reveal-pop reveal-delay-3">
          <p class="chiffre-valeur">8,2 t</p>
          <p class="chiffre-label">d'empreinte carbone moyenne par Français et par an. Objectif : 2 t en 2050</p>
          <p class="chiffre-source">SDES, 2024</p>
        </div>
      </div>
      <p class="reveal" style="color: var(--color-muted); margin-top: 1.5rem; font-size: 0.95rem; text-align: left;">
        Dans le guide complet : ce que ces chiffres veulent dire pour vous, le mini-calcul à faire vous-même et 9 gestes concrets. Ni culpabilité, ni déni.
      </p>
    </div>
  </section>

  <!-- Express ou complet -->
  <section id="express-ou-complet" class="guide-vert">
    <div style="max-width: 1100px; margin: 0 auto; padding: 7rem 3rem;">
      <div class="reveal" style="max-width: 760px; margin-bottom: 3.5rem;">
        <span class="pill-jaune">Express ou complet ?</span>
        <h2 style="font-size: clamp(2rem, 4vw, 3.2rem); margin-top: 1.5rem; color: #F9F4EE;">
          L'express vous met le pied à l'étrier.<br/>
          <span style="color: #F2B632;">Le complet vous rend autonome.</span>
        </h2>
        <p style="margin-top: 1.25rem; font-size: 1.02rem; line-height: 1.8; color: rgba(249, 244, 238, 0.8); text-align: left;">
          La version express est en accès libre, sans email : 9 pages pour vos premiers réflexes.
          Quand vous voudrez tout savoir, le guide complet vous attend.
        </p>
      </div>

      <div class="reveal" style="overflow-x: auto;">
        <table class="comparatif">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Contenu</span></th>
              <th scope="col">
                <img src="/guides/couverture-guide-claude.jpg" alt="" width="900" height="1272" class="comparatif-cover" />
                <span class="comparatif-nom">Express</span>
                <span class="comparatif-pages">9 pages · sans email</span>
              </th>
              <th scope="col" class="col-complet">
                <img src="/guides/couverture-guide-claude-complet.jpg" alt="" width="900" height="1272" class="comparatif-cover" />
                <span class="comparatif-nom">Complet</span>
                <span class="comparatif-pages">23 pages · gratuit</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {comparatif.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {[row.express, row.complet].map((cell, i) => (
                  <td class={i === 1 ? 'col-complet' : ''}>
                    {cell === null && <span class="cell-non" aria-label="Non inclus">—</span>}
                    {typeof cell === 'string' && cell}
                    {Array.isArray(cell) && (
                      <span class="jauge" aria-label={`${cell[0]} sur ${cell[1]}`}>
                        <span class="jauge-points" aria-hidden="true">
                          {Array.from({ length: cell[1] }, (_, k) => <span class={k < cell[0] ? 'on' : ''}></span>)}
                        </span>
                        <span aria-hidden="true">{cell[0]} sur {cell[1]}</span>
                      </span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row"><span class="sr-only">Télécharger</span></th>
              <td>
                <a href={EXPRESS_PDF} target="_blank" rel="noopener" class="cta-express">Lire l'express</a>
              </td>
              <td class="col-complet">
                <a href={TALLY_URL} class="cta-complet">Recevoir le complet</a>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>

  <!-- Auteur -->
  <section>
    <div id="guide-auteur" style="
      max-width: 1100px;
      margin: 0 auto;
      padding: 6rem 3rem;
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 4rem;
      align-items: center;
    ">
      <img
        src="/photo-profil.jpeg"
        alt="Julien Lacaze"
        width="200"
        height="200"
        class="reveal-left"
        style="width: 200px; height: 200px; object-fit: cover; border-radius: 50%; border: 1px solid var(--color-border);"
      />
      <div class="reveal">
        <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">L'auteur</p>
        <h2 style="font-size: 2rem; margin-bottom: 1.25rem;">Julien Lacaze</h2>
        <p style="color: var(--color-muted); font-size: 1rem; line-height: 1.8; text-align: left;">
          CMO freelance à Bordeaux, j'accompagne startups et PME dans leur marketing depuis plus de 10 ans.
          J'anime l'atelier 2 Tonnes depuis 2022 : plus de 70 ateliers et plus de 700 personnes sensibilisées
          aux ordres de grandeur de la transition écologique. Aujourd'hui, je forme des indépendants et des
          entrepreneurs à utiliser l'IA avec méthode, esprit critique et sobriété.
        </p>
        <p style="color: var(--color-muted); font-size: 0.85rem; line-height: 1.7; margin-top: 1.25rem; opacity: 0.8; text-align: left;">
          Transparence : ce guide a été rédigé avec l'aide de Claude, puis relu, vérifié et validé par mes soins.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="border-top: 1px solid var(--color-border);">
    <div style="max-width: 900px; margin: 0 auto; padding: 6rem 3rem;">
      <h2 class="reveal" style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin-bottom: 2.5rem;">Questions fréquentes</h2>
      {faq.map((item) => (
        <details class="guide-faq reveal">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA final -->
  <section id="guide-cta-final" style="
    padding: 8rem 3rem;
    text-align: center;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  ">
    <div class="reveal">
      <h2 style="font-size: clamp(2rem, 4vw, 3.5rem); margin-bottom: 1.25rem;">
        Démarrez avec Claude, <em style="color: var(--color-accent);">du bon pied</em>.
      </h2>
      <p style="color: var(--color-muted); max-width: 520px; margin: 0 auto 2.5rem; font-size: 1rem; text-align: center;">
        23 pages, 11 sections, 3 exercices. Et des réflexes que vous garderez longtemps.
      </p>
      <a href={TALLY_URL} class="guide-cta">Recevoir le guide complet</a>
      <p style="font-size: 0.8rem; color: var(--color-muted); margin-top: 1.25rem; text-align: center;">
        Gratuit · Téléchargement immédiat · Sans spam
      </p>
    </div>
  </section>

</Layout>

<style>
  /* Couleurs de la charte du guide, utilisées seulement sur cette page */
  #express-ou-complet {
    --guide-vert: #1E4D3B;
    --guide-orange: #D9622A;
    --guide-jaune: #F2B632;
    --guide-creme: #F9F4EE;
  }

  .guide-cta {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-bg);
    padding: 1.1rem 2.5rem;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 1px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .guide-cta:hover {
    background: var(--color-accent2);
    transform: translateY(-2px);
  }
  .guide-cta:focus-visible,
  .cta-express:focus-visible,
  .cta-complet:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  /* Couvertures empilées : le complet devant, l'express derrière */
  #guide-cover {
    position: relative;
    max-width: 420px;
    width: 100%;
    margin: 0 auto;
    aspect-ratio: 900 / 1272;
  }
  .cover-front,
  .cover-back {
    position: absolute;
    height: auto;
    box-shadow: 0 30px 60px -20px rgba(28, 25, 22, 0.35);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cover-front {
    width: 88%;
    right: 0;
    top: 0;
    transform: rotate(3deg);
  }
  .cover-back {
    width: 70%;
    left: 0;
    bottom: -4%;
    transform: rotate(-7deg);
    opacity: 0.9;
  }
  #guide-cover:hover .cover-front { transform: rotate(0deg) translateY(-6px); }
  #guide-cover:hover .cover-back { transform: rotate(-10deg) translateX(-8px); }

  /* Programme */
  .programme-item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .programme-num {
    font-family: var(--font-display);
    font-size: 1.8rem;
    line-height: 1.1;
    color: var(--color-accent);
  }
  .badge-exclusif {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1E4D3B;
    background: #F2B632;
    padding: 2px 9px;
    border-radius: 999px;
    vertical-align: middle;
  }

  /* Chiffres */
  .chiffre {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 2rem;
    border-radius: 2px;
  }
  .chiffre-valeur {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    line-height: 1.1;
