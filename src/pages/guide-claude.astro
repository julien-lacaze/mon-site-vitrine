---
import Layout from '../layouts/Layout.astro';

// Lien du formulaire Tally qui collecte les emails (formulaire publié sur Tally).
// La page de remerciement du formulaire renvoie vers le guide complet.
const TALLY_URL = 'https://tally.so/r/pb8aO8';

// Le guide express reste en accès libre, sans email : c'est l'avant-goût du guide complet.
const EXPRESS_PDF = '/guides/guide-claude-les-bases-express.pdf';

// Prise de rendez-vous (même lien que sur la page d'accueil).
const CALENDLY_URL = 'https://calendly.com/julien-lacaze-pro/cafe-virtuel';

// L'offre réelle : former les équipes sur place.
const formats = [
  {
    duree: 'Une demi-journée',
    titre: 'Les bases, ensemble',
    texte: "Comprendre Claude et ses outils, régler les comptes de chacun, apprendre à bien demander. Pour démarrer toute l'équipe sur de bonnes bases.",
    accent: 'var(--color-accent)',
  },
  {
    duree: 'Une journée',
    titre: 'De la théorie à vos cas réels',
    texte: "Les bases, puis des exercices sur les vraies tâches de votre équipe. Et les règles d'usage à poser ensemble : données, RGPD, vérification.",
    accent: 'var(--color-accent2)',
  },
  {
    duree: 'Dans la durée',
    titre: 'Accompagnement et audit',
    texte: "Un suivi de votre équipe après la formation, et un audit de sobriété de vos usages de l'IA pour consommer moins et mieux.",
    accent: 'var(--color-accent3)',
  },
];

const programme = [
  { num: '01', title: "Faut-il utiliser l'IA ?", text: 'Un arbre de décision en 5 questions, et 5 cas limites commentés.' },
  { num: '02', title: 'Les trois portes', text: 'Claude, Cowork, Claude Code : lequel pour quel besoin.' },
  { num: '03', title: 'Les modèles', text: 'Haiku, Sonnet, Opus : quel modèle pour quelle tâche.' },
  { num: '04', title: 'Les tarifs', text: 'Quel plan pour quel profil, et quand ne pas payer plus.' },
  { num: '05', title: 'Le setup', text: 'Les 9 réglages qui changent tout, avec des modèles à copier.' },
  { num: '06', title: 'Bien demander', text: 'Les 4 réflexes pour obtenir de bonnes réponses.' },
  { num: '07', title: 'Limites et vigilance', text: 'Hallucinations, injections de prompt, données personnelles, biais. Et une checklist RGPD en 7 points.' },
  { num: '08', title: 'Sobriété', text: 'Des ordres de grandeur sourcés et 9 gestes concrets.' },
  { num: '09', title: 'Garder la main', text: "Dépendance cognitive, flatterie de l'IA, la règle des 3 temps." },
  { num: '10', title: 'Trois exercices', text: 'Setup, avant/après, tri et vérification. Avec votre vrai compte.' },
  { num: '11', title: 'Aller plus loin', text: 'Glossaire, sources et ressources.' },
];

// Ce que contient le guide complet, en chiffres (tous tirés du PDF).
const contenu = [
  { chiffre: '3', titre: 'Outils comparés', texte: 'Claude, Cowork, Claude Code : lequel pour quel besoin, et la règle pour choisir.' },
  { chiffre: '3', titre: 'Familles de modèles', texte: 'Haiku, Sonnet, Opus : quel modèle pour quelle tâche, sans gaspiller.' },
  { chiffre: '5', titre: 'Plans décryptés', texte: 'De Free à Enterprise : quel plan pour quel profil, et quand ne pas payer plus.' },
  { chiffre: '9', titre: 'Réglages pas à pas', texte: 'Instructions, mémoire, projets, connecteurs, skills, routines... avec des modèles à copier.' },
  { chiffre: '4', titre: 'Réflexes pour bien demander', texte: 'Contexte, format, questions, critique : de la réponse correcte à la réponse utile.' },
  { chiffre: '5', titre: 'Cas limites commentés', texte: 'Contrat, CV, TVA, avis client, bio : pour affiner votre jugement.' },
  { chiffre: '7', titre: 'Points de checklist RGPD', texte: 'Et les 4 risques à connaître : hallucinations, injections de prompt, données, biais.' },
  { chiffre: '9', titre: 'Gestes de sobriété', texte: 'Avec des chiffres sourcés (ADEME, Google, Mistral) et un mini-calcul à faire vous-même.' },
];

// Ce que le lecteur a en main après les 3 exercices du guide.
const resultats = [
  'Des instructions rédigées et une confidentialité maîtrisée',
  'Un prompt réutilisable et le réflexe du contexte',
  'Votre grille vert, orange, rouge et un réflexe de vérification',
  'Un glossaire de 12 termes et toutes les sources',
];

const faq = [
  {
    q: "Je n'y connais rien en IA. Ce guide est-il fait pour moi ?",
    a: "Oui, c'est précisément pour vous. Il s'adresse aux indépendants, entrepreneurs et membres d'une équipe qui démarrent avec Claude. Pas besoin de savoir coder, ni de connaître l'IA.",
  },
  {
    q: 'Le guide est-il vraiment gratuit ?',
    a: "Oui, les deux versions. Pour le guide complet, vous laissez votre email et vous le téléchargez tout de suite. La version express est en accès libre, sans email. Rien à payer, aucune carte bancaire demandée.",
  },
  {
    q: 'Quelle différence entre la version express et le guide complet ?',
    a: "La version express (9 pages) donne les premiers réflexes : quand utiliser l'IA, 2 réglages, le réflexe n°1 pour bien demander. Le guide complet (23 pages) couvre tout : les outils, les modèles, les tarifs, les 9 réglages, les 4 réflexes, les limites, les chiffres de sobriété sourcés, 3 exercices, un glossaire et les sources.",
  },
  {
    q: 'Que faites-vous de mon email ?',
    a: "Il me permet de savoir qui lit le guide et, si vous l'acceptez, de vous recontacter avec des ressources sur l'IA utilisée avec méthode et sobriété. Il n'est ni vendu ni partagé. Un simple message suffit pour le faire supprimer.",
  },
  {
    q: 'Pouvez-vous former mon équipe ?',
    a: "Oui, c'est mon métier. Je viens dans vos locaux pour une demi-journée ou une journée de formation, sur vos outils et vos vrais cas. Je propose aussi un accompagnement dans la durée et un audit de sobriété de vos usages de l'IA. Le plus simple pour en parler : réservez un café virtuel.",
  },
];
---

<Layout
  title="Guide Claude"
  metaTitle="Guide gratuit : Claude, les bases pour tout comprendre | Julien Lacaze"
  description="Guide complet gratuit pour démarrer avec Claude avec méthode, esprit critique et sobriété. 23 pages, 11 sections, 9 réglages prêts à copier, 3 exercices. Sans jargon."
>

  <!-- Hero -->
  <section id="guide-hero" style="
    padding: 10rem 3rem 6rem;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 5rem;
    align-items: center;
  ">
    <div>
      <span class="tag fade-up">Guide complet gratuit · PDF</span>
      <h1 class="fade-up fade-up-delay-1" style="
        font-size: clamp(2.8rem, 5.5vw, 5rem);
        margin-top: 1.5rem;
        line-height: 1.05;
      ">
        Claude : les bases pour
        <em style="color: var(--color-accent); font-style: italic;">tout</em> comprendre.
      </h1>
      <p class="fade-up fade-up-delay-2" style="
        color: var(--color-muted);
        max-width: 540px;
        margin-top: 1.75rem;
        font-size: 1.1rem;
        line-height: 1.8;
        text-align: left;
      ">
        Le guide pour démarrer avec l'IA avec méthode, esprit critique et sobriété.
        Quel outil choisir, comment le régler, comment bien demander, et ce qu'il ne faut jamais lui confier.
      </p>

      <div class="fade-up fade-up-delay-3" style="margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem;">
        <a href={TALLY_URL} class="guide-cta">Recevoir le guide complet</a>
        <span style="font-size: 0.85rem; color: var(--color-muted);">Téléchargement immédiat après inscription</span>
      </div>

      <ul class="fade-up fade-up-delay-4" style="
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2rem;
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.85rem;
        color: var(--color-muted);
      ">
        <li><strong style="font-weight: 500; color: var(--color-text);">23 pages</strong>, 11 sections</li>
        <li><strong style="font-weight: 500; color: var(--color-text);">9 réglages</strong> prêts à copier</li>
        <li><strong style="font-weight: 500; color: var(--color-text);">3 exercices</strong> pratiques</li>
        <li><strong style="font-weight: 500; color: var(--color-text);">0 jargon</strong> inutile</li>
      </ul>
      <a href="#formation" class="hero-formation fade-up fade-up-delay-4">
        <span class="hero-formation-tag">Équipes</span>
        Vous voulez former toute votre équipe ? Je viens dans vos locaux
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div id="guide-cover" class="fade-up fade-up-delay-2">
      <img
        src="/guides/couverture-guide-claude-complet.jpg"
        alt="Couverture du guide complet « Claude : les bases pour tout comprendre » par Julien Lacaze"
        width="900"
        height="1272"
        class="cover-front"
      />
    </div>
  </section>

  <!-- Pour qui -->
  <section style="
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  ">
    <div style="max-width: 900px; margin: 0 auto; padding: 6rem 3rem; text-align: center;" class="reveal">
      <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.5rem; text-align: center;">Pour qui ?</p>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 1.2;">
        Vous avez ouvert Claude, posé deux questions,
        et vous vous demandez si vous l'utilisez <em style="color: var(--color-accent);">vraiment</em> bien ?
      </h2>
      <p style="color: var(--color-muted); margin-top: 2rem; font-size: 1.05rem; line-height: 1.8; text-align: center;">
        Ce guide s'adresse aux indépendants, entrepreneurs et membres d'une équipe qui démarrent avec l'IA.
        Pas besoin de savoir coder. L'objectif : que Claude travaille vraiment pour vous, sans que vous perdiez la main.
      </p>
    </div>
  </section>

  <!-- Programme -->
  <section style="max-width: 1400px; margin: 0 auto; padding: 8rem 3rem 4rem;">
    <div class="reveal" style="max-width: 700px; margin-bottom: 4rem;">
      <div class="sep"></div>
      <h2 style="font-size: clamp(2rem, 4vw, 3.2rem);">Au programme : 11 sections</h2>
      <p style="color: var(--color-muted); margin-top: 1.25rem; font-size: 1rem; line-height: 1.8; text-align: left;">
        Chaque section se termine par un « réflexe responsable » : le bon geste éthique ou écologique à retenir.
      </p>
    </div>

    <ol id="guide-programme" style="list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 4rem;">
      {programme.map((s) => (
        <li class="programme-item reveal">
          <span class="programme-num">{s.num}</span>
          <div>
            <h3 style="font-size: 1.25rem; line-height: 1.3;">{s.title}</h3>
            <p style="font-size: 0.92rem; color: var(--color-muted); line-height: 1.6; margin-top: 0.35rem; text-align: left;">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Extrait -->
  <section style="max-width: 1100px; margin: 0 auto; padding: 4rem 3rem 6rem;">
    <div class="reveal">
      <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Un avant-goût</p>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin-bottom: 2.5rem; max-width: 760px;">
        Le réflexe n°1 : que Claude vous connaisse <em style="color: var(--color-accent);">avant même</em> de répondre
      </h2>
    </div>
    <div id="guide-extrait" style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
      <div class="reveal-left" style="border: 1px solid var(--color-border); padding: 2rem; border-radius: 2px;">
        <p style="font-size: 0.72rem; color: var(--color-muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Avant</p>
        <ul class="fichiers" aria-label="Contexte donné à Claude">
          <li class="fichier fichier-vide">Claude ne sait rien de vous</li>
        </ul>
        <p style="font-family: var(--font-display); font-size: 1.3rem; line-height: 1.4; text-align: left;">« Écris-moi un post LinkedIn pour gagner des clients. »</p>
      </div>
      <div class="reveal-right" style="background: var(--color-text); color: var(--color-bg); padding: 2rem; border-radius: 2px;">
        <p style="font-size: 0.72rem; color: var(--color-border); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Après</p>
        <ul class="fichiers" aria-label="Fichiers lus par Claude avant de répondre">
          {['Qui je suis', 'Mon entreprise', 'Ma voix', 'Mes règles'].map((f) => (
            <li class="fichier">{f}</li>
          ))}
        </ul>
        <p style="font-family: var(--font-display); font-size: 1.15rem; line-height: 1.6; text-align: left;">
          « Lis les 4 fichiers (qui je suis, mon entreprise, ma voix et mes règles) à la racine du projet.
          Écris un post LinkedIn de 120 mots pour des dirigeants de PME, sur [sujet].
          Ton direct et chaleureux, pas de jargon inutile. Termine par une question.
          Si tu as besoin d'informations, pose-moi 3 questions avant. »
        </p>
      </div>
    </div>
    <p class="reveal" style="color: var(--color-muted); margin-top: 1.5rem; font-size: 0.95rem; line-height: 1.8; text-align: left; max-width: 820px;">
      Même outil, même demande. La différence : 4 fichiers que Claude lit avant de vous répondre.
      Rédigés une fois, ils servent à chaque conversation, et Claude écrit enfin comme vous.
      Ce qu'on y met et comment les construire, c'est là que tout se joue.
    </p>
  </section>

  <!-- Chiffres de sobriété -->
  <section style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto; padding: 6rem 3rem;">
      <div class="reveal" style="max-width: 700px; margin-bottom: 3rem;">
        <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Sobriété</p>
        <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.6rem);">Des ordres de grandeur sourcés</h2>
      </div>
      <div id="guide-chiffres" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
        <div class="chiffre reveal-pop reveal-delay-1">
          <p class="chiffre-valeur">4,4 %</p>
          <p class="chiffre-label">de l'empreinte carbone de la France vient du numérique</p>
          <p class="chiffre-source">ADEME et Arcep, 2022</p>
        </div>
        <div class="chiffre reveal-pop reveal-delay-2">
          <p class="chiffre-valeur">0,03 à 1,14 g</p>
          <p class="chiffre-label">de CO2e par requête texte, selon la méthode de mesure</p>
          <p class="chiffre-source">Google et Mistral AI, 2025</p>
        </div>
        <div class="chiffre reveal-pop reveal-delay-3">
          <p class="chiffre-valeur">8,2 t</p>
          <p class="chiffre-label">d'empreinte carbone moyenne par Français et par an. Objectif : 2 t en 2050</p>
          <p class="chiffre-source">SDES, 2024</p>
        </div>
      </div>
      <p class="reveal" style="color: var(--color-muted); margin-top: 1.5rem; font-size: 0.95rem; text-align: left;">
        Dans le guide complet : ce que ces chiffres veulent dire pour vous, le mini-calcul à faire vous-même et 9 gestes concrets. Ni culpabilité, ni déni.
      </p>
    </div>
  </section>

  <!-- Le guide complet -->
  <section id="guide-complet" class="guide-vert">
    <div style="max-width: 1200px; margin: 0 auto; padding: 7rem 3rem;">
      <div class="reveal" style="max-width: 780px; margin-bottom: 4rem;">
        <span class="pill-jaune">Dans le guide complet</span>
        <h2 style="font-size: clamp(2rem, 4vw, 3.2rem); margin-top: 1.5rem; color: #F9F4EE;">
          23 pages pour passer de la découverte<br/>
          <span style="color: #F2B632;">à l'autonomie.</span>
        </h2>
        <p style="margin-top: 1.25rem; font-size: 1.02rem; line-height: 1.8; color: rgba(249, 244, 238, 0.8); text-align: left;">
          Tout ce qu'il faut pour choisir le bon outil, le régler, bien lui parler et garder la main.
          Concret, sourcé, et pensé pour être appliqué tout de suite.
        </p>
      </div>

      <div id="complet-grille" style="display: grid; grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: start;">
        <ul class="complet-tuiles" style="list-style: none;">
          {contenu.map((c, i) => (
            <li class={`complet-tuile reveal-pop reveal-delay-${(i % 2) + 1}`}>
              <p class="complet-chiffre">{c.chiffre}</p>
              <div>
                <h3 class="complet-titre">{c.titre}</h3>
                <p class="complet-texte">{c.texte}</p>
              </div>
            </li>
          ))}
        </ul>

        <aside class="complet-carte reveal">
          <img src="/guides/couverture-guide-claude-complet.jpg" alt="" width="900" height="1272" class="complet-cover" />
          <p class="complet-nom">Guide complet</p>
          <p class="complet-pages">23 pages · 11 sections · gratuit</p>
          <p class="complet-repartez">Vous repartez avec</p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.8rem;">
            {resultats.map((r) => (
              <li class="complet-resultat">
                <span class="complet-check" aria-hidden="true"></span>
                {r}
              </li>
            ))}
          </ul>
          <a href={TALLY_URL} class="cta-complet">Recevoir le guide complet</a>
          <a href={EXPRESS_PDF} target="_blank" rel="noopener" class="complet-express">
            Pas encore prêt ? Lire la version express (9 pages, sans email)
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Formation sur place -->
  <section id="formation" style="border-bottom: 1px solid var(--color-border); background: var(--color-surface);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 7rem 3rem;">
      <div class="reveal" style="max-width: 780px; margin-bottom: 3.5rem;">
        <span class="tag">Formation sur place</span>
        <h2 style="font-size: clamp(2rem, 4vw, 3.2rem); margin-top: 1.5rem;">
          Les bases sont maîtrisées ?<br/>
          <em style="color: var(--color-accent);">Faites passer votre équipe au niveau supérieur.</em>
        </h2>
        <p style="color: var(--color-muted); margin-top: 1.25rem; font-size: 1.05rem; line-height: 1.8; text-align: left;">
          Je viens former vos équipes dans vos locaux, sur vos outils et vos vrais cas.
          Même approche que le guide : méthode, esprit critique et sobriété. Chacun repart avec un Claude réglé et des réflexes qu'il applique dès le lendemain.
        </p>
      </div>

      <div id="formation-formats" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
        {formats.map((f, i) => (
          <article class={`card reveal-pop reveal-delay-${i + 1}`} style={`--card-accent: ${f.accent}; background: var(--color-bg);`}>
            <p style={`font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: ${f.accent}; margin-bottom: 1rem;`}>{f.duree}</p>
            <h3 style="font-size: 1.5rem; line-height: 1.2; margin-bottom: 1rem;">{f.titre}</h3>
            <p style="font-size: 0.92rem; color: var(--color-muted); line-height: 1.7; text-align: left;">{f.texte}</p>
          </article>
        ))}
      </div>

      <div id="formation-preuves" class="reveal" style="
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-top: 3rem;
        padding: 2rem 0;
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
      ">
        <div><p class="preuve-chiffre">70+</p><p class="preuve-label">ateliers 2 Tonnes animés depuis 2022</p></div>
        <div><p class="preuve-chiffre">700+</p><p class="preuve-label">personnes sensibilisées en atelier</p></div>
        <div><p class="preuve-chiffre">10 ans</p><p class="preuve-label">de marketing en startups et PME</p></div>
      </div>

      <div class="reveal" style="margin-top: 3rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem;">
        <a href={CALENDLY_URL} target="_blank" rel="noopener" class="guide-cta">Parlons de votre équipe</a>
        <a href="/#contact" class="hover-accent" style="font-size: 0.9rem; color: var(--color-accent);">Ou écrivez-moi</a>
      </div>
    </div>
  </section>

  <!-- Auteur -->
  <section>
    <div id="guide-auteur" style="
      max-width: 1100px;
      margin: 0 auto;
      padding: 6rem 3rem;
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 4rem;
      align-items: center;
    ">
      <img
        src="/photo-profil.jpeg"
        alt="Julien LACAZE"
        width="200"
        height="200"
        class="reveal-left"
        style="width: 200px; height: 200px; object-fit: cover; border-radius: 50%; border: 1px solid var(--color-border);"
      />
      <div class="reveal">
        <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">L'auteur</p>
        <h2 style="font-size: 2rem; margin-bottom: 1.25rem;">Julien LACAZE</h2>
        <p style="color: var(--color-muted); font-size: 1rem; line-height: 1.8; text-align: left;">
          CMO freelance à Bordeaux, j'accompagne startups et PME dans leur marketing depuis plus de 10 ans.
          J'anime l'atelier 2 Tonnes depuis 2022 : plus de 70 ateliers et plus de 700 personnes sensibilisées
          aux ordres de grandeur de la transition écologique. Aujourd'hui, je forme des indépendants et des
          entrepreneurs à utiliser l'IA avec méthode, esprit critique et sobriété.
        </p>
        <p style="color: var(--color-muted); font-size: 0.85rem; line-height: 1.7; margin-top: 1.25rem; opacity: 0.8; text-align: left;">
          Transparence : ce guide a été rédigé avec l'aide de Claude, puis relu, vérifié et validé par mes soins.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="border-top: 1px solid var(--color-border);">
    <div style="max-width: 900px; margin: 0 auto; padding: 6rem 3rem;">
      <h2 class="reveal" style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin-bottom: 2.5rem;">Questions fréquentes</h2>
