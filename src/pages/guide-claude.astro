---
import Layout from '../layouts/Layout.astro';

// Lien du formulaire Tally qui collecte les emails (formulaire publié sur Tally).
const TALLY_URL = 'https://tally.so/r/pb8aO8';

const sections = [
  {
    num: '01',
    title: "Faut-il utiliser l'IA pour cette tâche ?",
    text: "Un arbre de décision en 5 questions et un code couleur vert, orange, rouge pour savoir quand y aller, quand rester vigilant, et quand s'abstenir.",
    accent: 'var(--color-accent3)',
  },
  {
    num: '02',
    title: 'Vos 2 premiers réglages',
    text: "Les instructions pour Claude, prêtes à copier, et le réglage de confidentialité à vérifier avant tout le reste.",
    accent: 'var(--color-accent)',
  },
  {
    num: '03',
    title: 'Bien demander',
    text: "Le réflexe n°1 qui transforme une réponse moyenne en réponse utile, et un exercice de 10 minutes pour le constater par vous-même.",
    accent: 'var(--color-accent2)',
  },
  {
    num: '04',
    title: 'Les 3 choses à ne jamais coller dans Claude',
    text: "Données personnelles, identifiants, documents confidentiels : ce que rappelle la CNIL aux TPE et PME, en clair.",
    accent: 'var(--color-accent3)',
  },
  {
    num: '05',
    title: '5 gestes de sobriété',
    text: "Le bon modèle pour la bonne tâche, une conversation par sujet, et les ordres de grandeur à connaître. Sans culpabilité.",
    accent: 'var(--color-accent)',
  },
  {
    num: '06',
    title: 'Garder la main',
    text: "Dépendance cognitive et libre arbitre : comment profiter de l'IA sans cesser de réfléchir par vous-même.",
    accent: 'var(--color-accent2)',
  },
];

const faq = [
  {
    q: "Je n'y connais rien en IA. Ce guide est-il pour moi ?",
    a: "Oui, c'est précisément pour vous. Il s'adresse aux indépendants, entrepreneurs et membres d'une équipe qui démarrent avec Claude. Pas besoin de savoir coder, ni de connaître l'IA.",
  },
  {
    q: 'Le guide est-il vraiment gratuit ?',
    a: "Oui. Vous laissez votre email et vous téléchargez le PDF tout de suite. Rien à payer, aucune carte bancaire demandée.",
  },
  {
    q: 'Que faites-vous de mon email ?',
    a: "Il me permet de savoir qui lit le guide et, si vous l'acceptez, de vous recontacter avec des ressources sur l'IA utilisée avec méthode et sobriété. Il n'est ni vendu ni partagé. Un simple message suffit pour le faire supprimer.",
  },
  {
    q: 'Et si je veux aller plus loin ?',
    a: "Il existe une version complète du guide (tarifs, modèles, les 9 réglages, les limites à connaître, 3 exercices, un glossaire et toutes les sources), ainsi que des formations d'une demi-journée ou d'une journée pour vous ou votre équipe.",
  },
];
---

<Layout
  title="Guide Claude"
  metaTitle="Guide gratuit : Claude, les bases pour tout comprendre | Julien Lacaze"
  description="Guide express gratuit pour démarrer avec Claude avec méthode, esprit critique et sobriété. 6 sections, des réglages prêts à copier, un exercice de 10 minutes. Sans jargon."
>

  <!-- Hero -->
  <section id="guide-hero" style="
    padding: 10rem 3rem 6rem;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 5rem;
    align-items: center;
  ">
    <div>
      <span class="tag fade-up">Guide gratuit · PDF</span>
      <h1 class="fade-up fade-up-delay-1" style="
        font-size: clamp(2.8rem, 5.5vw, 5rem);
        margin-top: 1.5rem;
        line-height: 1.05;
      ">
        Claude : les bases pour
        <em style="color: var(--color-accent); font-style: italic;">tout</em> comprendre.
      </h1>
      <p class="fade-up fade-up-delay-2" style="
        color: var(--color-muted);
        max-width: 540px;
        margin-top: 1.75rem;
        font-size: 1.1rem;
        line-height: 1.8;
        text-align: left;
      ">
        Le guide express pour démarrer avec l'IA avec méthode, esprit critique et sobriété.
        Ce qu'il faut régler, comment bien demander, et ce qu'il ne faut jamais coller dans Claude.
      </p>

      <div class="fade-up fade-up-delay-3" style="margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem;">
        <a href={TALLY_URL} class="guide-cta">Recevoir le guide gratuit</a>
        <span style="font-size: 0.85rem; color: var(--color-muted);">Téléchargement immédiat après inscription</span>
      </div>

      <ul class="fade-up fade-up-delay-4" style="
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2rem;
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.85rem;
        color: var(--color-muted);
      ">
        <li><strong style="font-weight: 500; color: var(--color-text);">9 pages</strong>, 6 sections</li>
        <li><strong style="font-weight: 500; color: var(--color-text);">2 réglages</strong> prêts à copier</li>
        <li><strong style="font-weight: 500; color: var(--color-text);">1 exercice</strong> de 10 minutes</li>
        <li><strong style="font-weight: 500; color: var(--color-text);">0 jargon</strong></li>
      </ul>
    </div>

    <div id="guide-cover" class="fade-up fade-up-delay-2" style="display: flex; justify-content: center;">
      <img
        src="/guides/couverture-guide-claude.jpg"
        alt="Couverture du guide express « Claude : les bases pour tout comprendre » par Julien Lacaze"
        width="900"
        height="1272"
        class="guide-cover-img"
        style="width: 100%; max-width: 400px; height: auto;"
      />
    </div>
  </section>

  <!-- Pour qui -->
  <section style="
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  ">
    <div style="max-width: 900px; margin: 0 auto; padding: 6rem 3rem; text-align: center;" class="reveal">
      <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.5rem; text-align: center;">Pour qui ?</p>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 1.2;">
        Vous avez ouvert Claude, posé deux questions,
        et vous vous demandez si vous l'utilisez <em style="color: var(--color-accent);">vraiment</em> bien ?
      </h2>
      <p style="color: var(--color-muted); margin-top: 2rem; font-size: 1.05rem; line-height: 1.8; text-align: center;">
        Ce guide s'adresse aux indépendants, entrepreneurs et membres d'une équipe qui démarrent avec l'IA.
        Pas besoin de savoir coder. L'objectif : que Claude travaille vraiment pour vous, sans que vous perdiez la main.
      </p>
    </div>
  </section>

  <!-- Contenu du guide -->
  <section style="max-width: 1400px; margin: 0 auto; padding: 8rem 3rem 4rem;">
    <div class="reveal" style="max-width: 700px; margin-bottom: 4rem;">
      <div class="sep"></div>
      <h2 style="font-size: clamp(2rem, 4vw, 3.2rem);">Ce que vous allez apprendre</h2>
      <p style="color: var(--color-muted); margin-top: 1.25rem; font-size: 1rem; line-height: 1.8; text-align: left;">
        Six sections courtes, chacune terminée par un « réflexe responsable » : le bon geste éthique ou écologique à retenir.
      </p>
    </div>

    <div id="guide-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
      {sections.map((s, i) => (
        <article class={`card reveal-pop reveal-delay-${(i % 3) + 1}`} style={`--card-accent: ${s.accent};`}>
          <div style={`font-family: var(--font-display); font-size: 2.5rem; line-height: 1; color: ${s.accent}; margin-bottom: 1.5rem;`}>{s.num}</div>
          <h3 style="font-size: 1.35rem; margin-bottom: 0.9rem; line-height: 1.25;">{s.title}</h3>
          <p style="font-size: 0.92rem; color: var(--color-muted); line-height: 1.7; text-align: left;">{s.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Extrait -->
  <section style="max-width: 1100px; margin: 0 auto; padding: 4rem 3rem 6rem;">
    <div class="reveal">
      <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Un avant-goût</p>
      <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin-bottom: 2.5rem;">Le réflexe n°1, en action</h2>
    </div>
    <div id="guide-extrait" style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
      <div class="reveal-left" style="border: 1px solid var(--color-border); padding: 2rem; border-radius: 2px;">
        <p style="font-size: 0.72rem; color: var(--color-muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Avant</p>
        <p style="font-family: var(--font-display); font-size: 1.3rem; line-height: 1.4; text-align: left;">« Fais-moi un post LinkedIn. »</p>
      </div>
      <div class="reveal-right" style="background: var(--color-text); color: var(--color-bg); padding: 2rem; border-radius: 2px;">
        <p style="font-size: 0.72rem; color: var(--color-border); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Après</p>
        <p style="font-family: var(--font-display); font-size: 1.15rem; line-height: 1.6; text-align: left;">
          « Je suis [métier]. Écris un post LinkedIn de 120 mots pour des dirigeants de PME, sur [sujet].
          Ton direct et chaleureux, pas de jargon. Termine par une question.
          Si tu as besoin d'informations, pose-moi 3 questions avant. »
        </p>
      </div>
    </div>
    <p class="reveal" style="color: var(--color-muted); margin-top: 1.5rem; font-size: 0.95rem; text-align: left;">
      Même outil, même minute passée. La différence tient en trois ingrédients, détaillés dans le guide avec un exercice pour les tester sur une vraie demande de votre semaine.
    </p>
  </section>

  <!-- Réflexe responsable -->
  <section style="max-width: 1100px; margin: 0 auto; padding: 0 3rem 6rem;">
    <div class="reveal" style="
      background: var(--color-accent3);
      color: var(--color-bg);
      padding: 3.5rem;
      border-radius: 2px;
    ">
      <p style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.25rem; opacity: 0.8;">Le fil rouge du guide</p>
      <p style="font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.3; text-align: left;">
        « L'IA est un outil puissant. Elle ne décide pas à votre place. »
      </p>
      <p style="margin-top: 1.5rem; font-size: 1rem; line-height: 1.8; opacity: 0.9; text-align: left; max-width: 720px;">
        Ni culpabilité, ni déni. Chaque section se termine par un réflexe concret pour protéger vos données,
        limiter l'impact environnemental de vos usages et garder votre esprit critique.
      </p>
    </div>
  </section>

  <!-- Auteur -->
  <section style="border-top: 1px solid var(--color-border);">
    <div id="guide-auteur" style="
      max-width: 1100px;
      margin: 0 auto;
      padding: 6rem 3rem;
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 4rem;
      align-items: center;
    ">
      <img
        src="/photo-profil.jpeg"
        alt="Julien Lacaze"
        width="200"
        height="200"
        class="reveal-left"
        style="width: 200px; height: 200px; object-fit: cover; border-radius: 50%; border: 1px solid var(--color-border);"
      />
      <div class="reveal">
        <p style="font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">L'auteur</p>
        <h2 style="font-size: 2rem; margin-bottom: 1.25rem;">Julien Lacaze</h2>
        <p style="color: var(--color-muted); font-size: 1rem; line-height: 1.8; text-align: left;">
          CMO freelance à Bordeaux, j'accompagne startups et PME dans leur marketing depuis plus de 10 ans.
          J'anime l'atelier 2 Tonnes depuis 2022 : plus de 70 ateliers et plus de 700 personnes sensibilisées
          aux ordres de grandeur de la transition écologique. Aujourd'hui, je forme des indépendants et des
          entrepreneurs à utiliser l'IA avec méthode, esprit critique et sobriété.
        </p>
        <p style="color: var(--color-muted); font-size: 0.85rem; line-height: 1.7; margin-top: 1.25rem; opacity: 0.8; text-align: left;">
          Transparence : ce guide a été rédigé avec l'aide de Claude, puis relu, vérifié et validé par mes soins.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="border-top: 1px solid var(--color-border);">
    <div style="max-width: 900px; margin: 0 auto; padding: 6rem 3rem;">
      <h2 class="reveal" style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin-bottom: 2.5rem;">Questions fréquentes</h2>
      {faq.map((item) => (
        <details class="guide-faq reveal">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA final -->
  <section id="guide-cta-final" style="
    padding: 8rem 3rem;
    text-align: center;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  ">
    <div class="reveal">
      <h2 style="font-size: clamp(2rem, 4vw, 3.5rem); margin-bottom: 1.25rem;">
        Démarrez avec Claude, <em style="color: var(--color-accent);">du bon pied</em>.
      </h2>
      <p style="color: var(--color-muted); max-width: 520px; margin: 0 auto 2.5rem; font-size: 1rem; text-align: center;">
        9 pages, 15 minutes de lecture, et des réflexes que vous garderez longtemps.
      </p>
      <a href={TALLY_URL} class="guide-cta">Recevoir le guide gratuit</a>
      <p style="font-size: 0.8rem; color: var(--color-muted); margin-top: 1.25rem; text-align: center;">
        Gratuit · Téléchargement immédiat · Sans spam
      </p>
    </div>
  </section>

</Layout>

<style>
  .guide-cta {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-bg);
    padding: 1.1rem 2.5rem;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 1px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .guide-cta:hover {
    background: var(--color-accent2);
    transform: translateY(-2px);
  }
  .guide-cta:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .guide-cover-img {
    transform: rotate(2deg);
    box-shadow: 0 30px 60px -20px rgba(28, 25, 22, 0.35);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .guide-cover-img:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .guide-faq {
    border-bottom: 1px solid var(--color-border);
    padding: 1.5rem 0;
  }
  .guide-faq summary {
    font-family: var(--font-display);
    font-size: 1.2rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .guide-faq summary::-webkit-details-marker { display: none; }
  .guide-faq summary::after {
    content: '+';
    color: var(--color-accent);
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }
  .guide-faq[open] summary::after { transform: rotate(45deg); }
  .guide-faq p {
    color: var(--color-muted);
    margin-top: 1rem;
    font-size: 0.98rem;
    line-height: 1.8;
    text-align: left;
  }

  @media (max-width: 1024px) {
    #guide-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }

  @media (max-width: 768px) {
    #guide-hero { grid-template-columns: 1fr !important; gap: 3rem !important; padding: 8rem 1.5rem 4rem !important; }
    #guide-cover { order: -1; }
    .guide-cover-img { max-width: 240px !important; }
    #guide-grid { grid-template-columns: 1fr !important; }
    #guide-extrait { grid-template-columns: 1fr !important; }
    #guide-auteur { grid-template-columns: 1fr !important; gap: 2rem !important; padding: 4rem 1.5rem !important; }
    #guide-cta-final { padding: 5rem 1.5rem !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-cover-img, .guide-cta { transition: none; }
  }
</style>
