---
import Layout from '../layouts/Layout.astro';

// Missions, de la plus récente à la plus ancienne.
// `result` est optionnel : la ligne « Résultat » ne s'affiche que s'il est renseigné.
type Mission = {
  id: string;
  name: string;
  logo: string;
  date: string;
  type: string;
  details: string[];
  context: string;
  actions: string[];
  result?: string;
};

const missions: Mission[] = [
  {
    id: 'coedis',
    name: 'Coédis',
    logo: '/logos/coedis.png',
    date: 'Avril 2026',
    type: 'Email marketing',
    details: ['BTP, gros œuvre', 'Convention B2B, 500 personnes', 'Distanciel'],
    context: "Déploiement de la stratégie d'email marketing dans le cadre de la 1ère grande convention B2B (Coédis Impact) de la Fédération des Distributeurs professionnels spécialisés.",
    actions: ["Stratégie d'email marketing B2B"],
  },
  {
    id: 'alexia',
    name: 'Alexia.fr',
    logo: '/logos/alexia.png',
    date: 'Novembre 2025',
    type: 'Copywriting',
    details: ['Droit', 'Distanciel'],
    context: 'Copywriting des pages business du site alexia.fr.',
    actions: [
      "Copywriting du funnel d'inscription du site alexia.fr, page d'accueil, page divorce à l'amiable",
      'Collaboration avec la personne chargée de la refonte UX / UI',
    ],
  },
  {
    id: 'sncf',
    name: 'SNCF',
    logo: '/logos/sncf.png',
    date: 'Oct. 2025 à mars 2026',
    type: 'Conseil',
    details: ['Transport, ferroviaire', 'Distanciel'],
    context: 'Migration du bilan carbone de SNCF Numérique Responsable vers le logiciel SaaS de comptabilité carbone Sweep.',
    actions: ['Migration du bilan carbone de SNCF Numérique Responsable vers le logiciel SaaS de comptabilité carbone Sweep'],
  },
  {
    id: 'noe',
    name: 'Noé',
    logo: '/logos/noe.png',
    date: '2025 à 2026',
    type: 'CMO part-time',
    details: ['Formation, enseignement', '2 jours par semaine'],
    context: "Noé est la formation n°1 de Product Manager en France. Un bootcamp de 4 semaines qui permet d'apprendre en profondeur le métier de Product Manager.",
    actions: [
      "Garant de la stratégie d'acquisition digitale : campagnes paid, SEO, contenu, email, social",
      'Pilotage et collaboration avec les agences externes (SEO / SEA)',
      "Lancement d'opérations growth",
      "Management d'une personne",
    ],
  },
  {
    id: 'geev',
    name: 'Geev',
    logo: '/logos/geev.png',
    date: 'Sept. 2024 à mai 2025',
    type: 'Marketing B2B',
    details: ['Économie circulaire', 'Présentiel'],
    context: 'Développement du marketing des offres B2B de Geev Pro : reprise par le don, comptes pro Geev.',
    actions: ['Lancement de campagnes cold emailing', 'Suivi et lancement des nouveaux comptes pro B2B'],
  },
];
---

<Layout title="Clients" description="Missions et cas clients de Julien Lacaze, CMO freelance B2B à Bordeaux">

  <!-- En-tête (fond cacao) -->
  <section class="head">
    <div class="wrap head-inner">
      <h1 class="head-title fade-up fade-up-delay-1">Ce que j'ai <span class="caramel">vraiment</span> fait.</h1>
      <p class="head-sub fade-up fade-up-delay-2">
        Les missions B2B sur lesquelles je suis intervenu récemment, de la plus récente à la plus ancienne.
        Économie circulaire, droit, formation, transport, BTP.
      </p>
    </div>
  </section>

  <!-- Vue d'ensemble (bandeau caramel) -->
  <section class="summary">
    <div class="wrap summary-grid">
      <div class="summary-item"><span class="summary-num">{missions.length}</span><span class="summary-label">missions récentes</span></div>
      <div class="summary-item"><span class="summary-num">5</span><span class="summary-label">secteurs différents</span></div>
      <div class="summary-item"><span class="summary-num">2024</span><span class="summary-label">à aujourd'hui</span></div>
    </div>
  </section>

  <!-- Frise -->
  <section class="timeline-wrap">
    <ol class="timeline">
      {missions.map((m) => (
        <li class="step reveal" id={m.id}>
          <div class="step-date">{m.date}</div>
          <div class="step-rail" aria-hidden="true"><span class="step-dot"></span><span class="step-line"></span></div>
          <article class="step-card">
            <div class="card-head">
              <div class="card-title">
                <h2 class="card-name">{m.name}</h2>
                <span class="card-type">{m.type}</span>
              </div>
              <img src={m.logo} alt="" class="card-logo" />
            </div>
            <p class="card-details">{m.details.join(' · ')}</p>
            <p class="card-context">{m.context}</p>
            <ul class="card-actions">
              {m.actions.map((a) => <li>{a}</li>)}
            </ul>
            {m.result && (
              <p class="card-result"><strong>Résultat : </strong>{m.result}</p>
            )}
          </article>
        </li>
      ))}
    </ol>
  </section>

  <!-- Appel à l'action -->
  <section class="cta">
    <div class="wrap cta-inner">
      <h2 class="cta-title">Vous voulez en faire partie ?</h2>
      <a href="/#contact" class="cta-btn">Me contacter</a>
    </div>
  </section>

  <style>
    .wrap { max-width: 1240px; margin: 0 auto; padding-left: 1.75rem; padding-right: 1.75rem; }
    .caramel { color: var(--color-caramel); }

    .head { background: var(--color-dark); color: var(--color-on-dark); padding: 8rem 0 4rem; }
    .head-inner { display: flex; flex-direction: column; gap: 1.2rem; }
    .head-title { font-size: clamp(2.4rem, 7vw, 5.4rem); }
    .head-sub { font-size: 1.1rem; color: var(--color-muted-on-dark); max-width: 36em; }

    .summary { background: var(--color-caramel); color: var(--color-dark); }
    .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
    .summary-item { padding: 1.4rem 0; display: flex; align-items: baseline; gap: 0.7rem; }
    .summary-num { font-weight: 900; font-stretch: 115%; font-size: 2.5rem; line-height: 1; letter-spacing: -0.03em; }
    .summary-label { font-weight: 600; font-size: 0.95rem; }

    .timeline-wrap { max-width: 1040px; margin: 0 auto; padding: 4.5rem 1.75rem 3rem; }
    .timeline { list-style: none; margin: 0; padding: 0; }
    .step { display: flex; gap: 1.3rem; scroll-margin-top: 6rem; }
    .step-date { flex: 0 0 8rem; padding-top: 1.3rem; text-align: right; font-weight: 700; font-size: 0.9rem; color: var(--color-accent); }
    .step-rail { flex: 0 0 18px; display: flex; flex-direction: column; align-items: center; }
    .step-dot { width: 16px; height: 16px; border-radius: 50%; background: var(--color-dark); border: 3px solid var(--color-caramel); margin-top: 1.35rem; flex-shrink: 0; }
    .step-line { width: 2px; flex: 1; background: #D9C9B6; }
    .step:last-child .step-line { background: linear-gradient(#D9C9B6, transparent); }
    .step-card { flex: 1 1 0; min-width: 0; margin-bottom: 1.6rem; background: var(--color-surface); border-radius: 6px; padding: 1.4rem 1.6rem; display: flex; flex-direction: column; gap: 0.7rem; }
    .card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
    .card-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 0.9rem; }
    .card-name { font-size: 1.9rem; line-height: 1; }
    .card-type { background: var(--color-dark); color: var(--color-caramel); border-radius: 999px; padding: 0.2rem 0.7rem; font-size: 0.8rem; font-weight: 700; }
    .card-logo { height: 30px; width: auto; max-width: 110px; object-fit: contain; opacity: 0.9; flex-shrink: 0; }
    .card-details { font-size: 0.85rem; font-weight: 600; color: var(--color-muted); }
    .card-context { color: #4A3F37; }
    .card-actions { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
    .card-actions li { position: relative; padding-left: 1.2rem; font-size: 0.95rem; color: #4A3F37; }
    .card-actions li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 8px; height: 8px; border-radius: 2px; background: var(--color-caramel); }
    .card-result { margin-top: 0.3rem; padding-top: 0.8rem; border-top: 1px solid #EFE6DA; font-size: 0.95rem; }
    .card-result strong { color: var(--color-accent); font-weight: 700; }

    .cta { background: var(--color-caramel); color: var(--color-dark); padding: 4.5rem 0; margin-bottom: -6rem; }
    .cta-inner { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between; }
    .cta-title { font-size: clamp(2rem, 4.5vw, 3.2rem); }
    .cta-btn { background: var(--color-dark); color: var(--color-on-dark); padding: 0.95rem 1.6rem; border-radius: 6px; font-weight: 700; }
    .cta-btn:hover { opacity: 0.88; }

    @media (max-width: 700px) {
      .wrap, .timeline-wrap { padding-left: 1.25rem !important; padding-right: 1.25rem !important; }
      .head, .summary, .cta { padding-left: 0 !important; padding-right: 0 !important; }
      .head { padding-top: 7rem; padding-bottom: 3rem; }
      .summary-item { padding: 1rem 0; }
      /* Sur téléphone : la date passe au-dessus de la carte, la ligne reste à gauche */
      .step { display: grid; grid-template-columns: 18px minmax(0, 1fr); column-gap: 0.9rem; }
      .step-date { grid-column: 2; grid-row: 1; text-align: left; padding-top: 0.15rem; padding-bottom: 0.4rem; }
      .step-rail { grid-column: 1; grid-row: 1 / span 2; }
      .step-dot { margin-top: 0.2rem; }
      .step-card { grid-column: 2; grid-row: 2; padding: 1.2rem; }
      .card-name { font-size: 1.6rem; }
      .card-logo { height: 24px; max-width: 80px; }
    }
  </style>

</Layout>
